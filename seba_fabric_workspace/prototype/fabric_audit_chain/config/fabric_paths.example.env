# Copy this file to fabric_paths.env only if your Fabric samples folder is not
# under prototype/fabric_audit_chain/.local/fabric-samples.

export FABRIC_SAMPLES_DIR="/absolute/path/to/fabric-samples"
export CHANNEL_NAME="seba"
export CHAINCODE_NAME="seba-audit"
export MSP_ID="Org1MSP"
export PEER_ENDPOINT="localhost:7051"
export PEER_HOST_ALIAS="peer0.org1.example.com"

# Optional explicit identity paths. Defaults are derived from FABRIC_SAMPLES_DIR.
# export TLS_CERT_PATH="$FABRIC_SAMPLES_DIR/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt"
# export CERT_DIRECTORY_PATH="$FABRIC_SAMPLES_DIR/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts"
# export KEY_DIRECTORY_PATH="$FABRIC_SAMPLES_DIR/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore"
