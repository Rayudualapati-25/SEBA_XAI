{
  "name": "seba-xai-fabric-audit-chaincode",
  "version": "0.1.0",
  "description": "Hyperledger Fabric chaincode for SEBA-XAI audit commitments",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "fabric-chaincode-node start",
    "lint:syntax": "node --check index.js && node --check lib/sebaAuditContract.js",
    "test": "mocha",
    "test:coverage": "nyc npm test"
  },
  "dependencies": {
    "fabric-contract-api": "^2.5.0",
    "fabric-shim": "^2.5.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0"
  },
  "nyc": {
    "exclude": [
      "coverage/**",
      "test/**",
      "index.js",
      ".mocharc*"
    ],
    "reporter": [
      "text",
      "text-summary",
      "html"
    ],
    "all": true,
    "check-coverage": true,
    "statements": 80,
    "branches": 80,
    "functions": 80,
    "lines": 80
  }
}
