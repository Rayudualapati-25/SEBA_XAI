{
  "//": "Multi-root workspace for SEBA-XAI. Open this file in VS Code (File > Open Workspace from File) to see the Fabric implementation, the Python research package, the paper and the results side by side.",
  "folders": [
    {
      "name": "Fabric implementation",
      "path": "seba_fabric_workspace/crime-records-network"
    },
    {
      "name": "Python research package",
      "path": "src/seba"
    },
    {
      "name": "Results",
      "path": "results"
    },
    {
      "name": "Paper",
      "path": "papers"
    },
    {
      "name": "Experiments",
      "path": "experiments"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/coverage": true,
      "**/.blockdemo": true,
      "**/.bootstrap-logs": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/coverage": true
    },
    "files.trimTrailingWhitespace": true,
    "editor.rulers": [88]
  }
}
